#!/bin/sh
# Fires the Test Writer Agent after every commit -- a real git-event trigger,
# not the orchestrator's polling loop. Runs detached so `git commit` itself
# is never blocked on an LLM call; agents/activity.log is where the result
# shows up. Fires for ANY commit (human, or either of the other two agents)
# on purpose -- the agent's own commit-sha gate decides quickly whether
# there's actually a coverage gap worth acting on.

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$REPO_ROOT" || exit 0

PYTHON="$REPO_ROOT/.venv/bin/python3"
[ -x "$PYTHON" ] || PYTHON="python3"

nohup "$PYTHON" -m agents.test_writer_agent >>"$REPO_ROOT/agents/activity.log" 2>&1 </dev/null &
disown 2>/dev/null || true
exit 0
